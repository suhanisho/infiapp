{
  "name": "infiloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "validate": "python3 repo_tools/validate_agents.py && python3 repo_tools/validate_dynamodb.py",
    "codegen": "python3 repo_tools/codegen.py",
    "codegen:check": "python3 repo_tools/codegen.py --check",
    "test:agents": "python3 -m unittest discover -s agents -p 'test_*.py'",
    "test:web": "npm --prefix webUI test",
    "test": "npm run test:agents && npm run test:web",
    "check": "npm run validate && npm run codegen:check && npm test && npm --prefix webUI run build"
  }
}

