            "patientId": "String | Null",
            "patientName": "String | Null",
            "priority": "String",
            "sourceMessage": "String | Null",
            "sourceMessageId": "String | Null",
            "sourceProvider": "String",
            "sourceSummary": "String",
            "sourceThreadId": "String | Null",
            "status": "String",
            "timeLabel": "String",
            "updatedAt": "String"
          }
        ]
      }
    },
    {
