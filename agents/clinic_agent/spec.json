{
  "description": "External Lambda agent for Dr. Shalini's Clinic action queue, patients, schedule, and settings.",
  "connectivity": "external",
  "memory_mb": 128,
  "timeout_seconds": 30,
  "ephemeral_storage_mb": 512,
  "api_context": [
    {
      "call": "approve_action",
      "description": "Records explicit doctor approval for an action and stores it as completed without sending messages or updating calendars.",
      "input": {
        "actionId": "String",
        "approvedBy?": "String",
        "finalMessage?": "String"
      },
      "output": {
        "action": {
          "actionId": "String",
          "actionType": "String",
          "approvedAt": "String | Null",
          "approvedBy": "String | Null",
          "completedAt": "String | Null",
          "completionNote": "String | Null",
          "createdAt": "String",
          "draftMessage": "String | Null",
          "externalDraftId": "String | Null",
          "externalSentMessageId": "String | Null",
          "finalMessage": "String | Null",
          "patientId": "String | Null",
          "patientName": "String | Null",
          "priority": "String",
          "sourceMessage": "String | Null",
          "sourceMessageId": "String | Null",
          "sourceProvider": "String",
          "sourceSummary": "String",
          "sourceThreadId": "String | Null",
          "status": "String",
          "timeLabel": "String",
          "updatedAt": "String"
        },
        "message": "String"
      }
    },
    {
      "call": "connect_google_workspace",
      "description": "Stores Auth.js-verified Google token material in a secret store and records safe Google Workspace connection metadata.",
      "input": {
        "accountEmail": "String",
        "tokenResponse": "Map"
      },
      "output": {
        "integrations": [
          {
            "accountEmail": "String | Null",
            "calendarId": "String | Null",
            "connectedAt": "String | Null",
            "integrationId": "String",
            "lastError": "String | Null",
            "lastSyncAt": "String | Null",
            "provider": "String",
            "requiredScopes": ["String"],
            "status": "String",
            "writeMode": "String"
          }
        ],
        "message": "String"
      }
    },
    {
      "call": "list_actions",
      "description": "Lists durable action queue records, including completed records when requested for future validation.",
      "input": {
        "includeCompleted?": "Boolean"
      },
      "output": {
        "actions": [
          {
            "actionId": "String",
            "actionType": "String",
            "approvedAt": "String | Null",
            "approvedBy": "String | Null",
            "completedAt": "String | Null",
            "completionNote": "String | Null",
            "createdAt": "String",
            "draftMessage": "String | Null",
            "externalDraftId": "String | Null",
            "externalSentMessageId": "String | Null",
